@Users.API_HostAddress = http://localhost:5290

GET {{Users.API_HostAddress}}/weatherforecast/
Accept: application/json

###

# Registra un usuario de prueba.
POST {{Users.API_HostAddress}}/api/users/register
Content-Type: application/json

{
  "nombre": "Agustin",
  "apellido": "Prueba",
  "email": "prueba@example.com",
  "password": "Clave123!"
}

###
###
# Inicia sesión con un usuario registrado.
POST {{Users.API_HostAddress}}/api/users/login
Content-Type: application/json

{
  "email": "agustin.prueba@example.com",
  "password": "Clave123!"
}

###

###
# Prueba una contraseña incorrecta.
POST {{Users.API_HostAddress}}/api/users/login
Content-Type: application/json

{
  "email": "agustin.prueba@example.com",
  "password": "ClaveIncorrecta!"
}

###

###
# Prueba el rechazo de datos inválidos.
POST {{Users.API_HostAddress}}/api/users/register
Content-Type: application/json

{
  "nombre": "Prueba",
  "apellido": "Usuario",
  "email": "esto-no-es-un-email",
  "password": "Clave123!"
}

###